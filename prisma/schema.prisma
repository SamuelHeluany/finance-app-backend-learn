
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id  String @id @default(uuid()) // id como string @id indicando ser chave primária e gerando UUID
  first_name String @db.VarChar(50) //first_name como string e limite de 50 caracteres
  last_name String @db.VarChar(50) // last_name como string e limite de 50 caracteres
  email String @db.VarChar(100) @unique // email como string, limite de 100 caracteres e @unique para informar que não pode ter outro email igual
  passsword String @db.VarChar(100)
}