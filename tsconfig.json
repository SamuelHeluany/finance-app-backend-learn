{
    "compilerOptions": {
        // File Layout
        "rootDir": ".",
        "outDir": "./dist",

        // Environment Settings
        "module": "nodenext",
        "target": "esnext",
        "lib": ["esnext"],
        "types": ["node"],

        // Other Outputs
        "sourceMap": true,

        // Stricter Typechecking Options
        "noUncheckedIndexedAccess": true,

        // Recommended Options
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "allowJs": true,
        "checkJs": false
    },
    "include": ["index.ts", "src"],
    "exclude": ["node_modules", "dist"]
}
